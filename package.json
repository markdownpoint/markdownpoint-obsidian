{
  "name": "markdownpoint-obsidian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Johan Sanneblad",
  "description": "Writing and organizing presentations, with visual finishing in the MarkdownPoint desktop app.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "check": "bash scripts/build.sh",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "lint:styles": "stylelint styles.css --max-warnings=0",
    "lint:docs": "markdownlint-cli2 README.md CONTRIBUTING.md SECURITY.md \"docs/*.md\"",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "moment": "2.31.0",
    "@codemirror/commands": {
      "@codemirror/language": "6.10.8"
    },
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "26.6.2",
    "esbuild": "0.28.1",
    "eslint": "10.13.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.12.0",
    "knip": "6.37.0",
    "markdownlint-cli2": "0.23.3",
    "obsidian": "1.13.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-no-unsupported-browser-features": "8.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "entities": "8.1.0",
    "jsonc-parser": "3.3.1",
    "marked": "18.0.13"
  }
}
