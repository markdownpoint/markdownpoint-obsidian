{
  "name": "markdownpoint-obsidian",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Johan Sanneblad",
  "description": "Writing and organizing presentations, with visual finishing in the MarkdownPoint desktop app.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "overrides": {
    "moment": "2.31.0",
    "@codemirror/commands": {
      "@codemirror/language": "6.10.8"
    },
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  },
  "devDependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "26.6.2",
    "esbuild": "0.28.1",
    "eslint": "10.13.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.12.0",
    "obsidian": "1.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "entities": "8.1.0",
    "jsonc-parser": "3.3.1",
    "marked": "18.0.13"
  }
}
